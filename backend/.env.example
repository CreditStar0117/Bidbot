# HTTP port
PORT=4500

# Address to bind. 0.0.0.0 is every interface on this machine, so a dashboard
# running on another computer can reach the API; 127.0.0.1 keeps it local.
HOST=0.0.0.0

# Root of the archive. Documents land in {DATA_ROOT}/{YYYY-MM-DD}/{company}/
DATA_ROOT=v:/Downloads/data

# SQLite file. Defaults to backend/database/jobsaver.db
# DB_FILE=D:/data/jobsaver.db

# Starting mode when the database holds no preference. The dashboard switch
# overrides it and the choice is remembered.
#   true  - automatic: render and file every submission on arrival
#   false - human check: hold each one until someone approves it
AUTO_SAVE=true

# Optional .ttf embedded in every PDF. Unset uses the built-in Helvetica, which
# covers Latin text only; point this at a Unicode face for CJK postings.
# PDF_FONT=C:/Windows/Fonts/malgun.ttf
# PDF_FONT_BOLD=C:/Windows/Fonts/malgunbd.ttf

# Job description HTML can be large
BODY_LIMIT=25mb

# Comma-separated origins allowed to call the API, or * for any
CORS_ORIGIN=*
